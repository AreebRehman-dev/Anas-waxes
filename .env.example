# Copy to .env.local and fill in. Both are optional.

# Public address of the site, used for social sharing links.
NEXT_PUBLIC_SITE_URL=https://anas-waxes.vercel.app

# Where the inquiry form posts (e.g. a Formspree URL). When empty, the form
# opens the visitor's email app with the message filled in instead.
NEXT_PUBLIC_INQUIRY_ENDPOINT=
